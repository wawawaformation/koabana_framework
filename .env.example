APP_ENV=dev
APP_DEBUG=1
# URL publique, utilisée pour les liens envoyés par e-mail (jamais l'en-tête Host de la requête)
APP_URL=https://<domaine>

LOG_FILE=var/log/app.log
LOG_LEVEL=debug


DB_DSN=mysql:host=<host>;port=3306;dbname=<dbname>;charset=utf8mb4
DB_USER=<user>
DB_PASSWORD=<password>

# Envoi d'e-mails (obligatoire : inscription, mot de passe oublié) — voir src/Mail/README.md
SMTP_HOST=<host>
SMTP_PORT=25
SMTP_AUTH=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
SMTP_AUTO_TLS=1
SMTP_DEBUG=0
SMTP_FROM_EMAIL=<email>
SMTP_FROM_NAME=Koabana
